  <MdxScripts>
    <MdxScript dwd:design-time-name="03148a64-42eb-4e2a-92b9-d6c8d4e30cd9">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Review Score]
 AS [Measures].[Review Score] / [Measures].[Review Count], 
FORMAT_STRING = "0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Delivery'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Late Delivery %]
 AS IIF([Measures].[Delivered Orders] = 0, NULL, [Measures].[Late Orders] / [Measures].[Delivered Orders]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Delivery' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Order Fulfilment'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Order Value]
 AS IIF([Measures].[Sales Orders] = 0, NULL, [Measures].[Revenue] / [Measures].[Sales Orders]), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Sales' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Order Fulfilment'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Item Price]
 AS IIF([Measures].[Items Sold] = 0, NULL, [Measures].[Revenue] / [Measures].[Items Sold]), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Sales' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Order Fulfilment'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Sales Orders]
 AS [Measures].[Orders With Items] - ([Measures].[Orders With Items], [Order Status].[Status Group].&amp;[Not fulfilled]), 
FORMAT_STRING = "#,##0", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Sales' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Order Fulfilment'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Items Sold]
 AS [Measures].[Quantity] - ([Measures].[Quantity], [Order Status].[Status Group].&amp;[Not fulfilled]), 
FORMAT_STRING = "#,##0", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Sales' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Sales'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Freight]
 AS [Measures].[Freight Value] - ([Measures].[Freight Value], [Order Status].[Status Group].&amp;[Not fulfilled]), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Sales' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Sales'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Revenue]
 AS [Measures].[Price] - ([Measures].[Price], [Order Status].[Status Group].&amp;[Not fulfilled]), 
FORMAT_STRING = "#,##0.00", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Sales' ,  ASSOCIATED_MEASURE_GROUP = 'Fact Sales'  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Delivery Days]
 AS [Measures].[Delivery Days] / [Measures].[Delivered Orders], 
FORMAT_STRING = "#,##0.0", 
VISIBLE = 1 ,  DISPLAY_FOLDER = 'Delivery'  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>