                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
       payment_type,
       CASE WHEN payment_type IN ('credit_card','debit_card') THEN 'Card'
            WHEN payment_type = 'boleto' THEN 'Bank slip'
            WHEN payment_type = 'voucher' THEN 'Voucher'
            ELSE 'Not defined' END AS payment_group
FROM stg.stg_order_payments
WHERE payment_type IS NOT NULL;</property>
