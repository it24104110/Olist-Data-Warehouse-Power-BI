                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
       order_status,
       CASE WHEN order_status = 'delivered' THEN 'Delivered'
            WHEN order_status IN ('canceled','unavailable') THEN 'Not fulfilled'
            ELSE 'In progress' END AS status_group,
       CASE WHEN order_status IN ('canceled','unavailable') THEN CAST(0 AS BIT)
            ELSE CAST(1 AS BIT) END AS counts_as_sale
FROM stg.stg_orders
WHERE order_status IS NOT NULL;</property>
