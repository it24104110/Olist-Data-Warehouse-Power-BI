                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT c.customer_unique_id,
       CAST(MIN(o.order_purchase_timestamp) AS DATE) AS first_order_date
FROM stg.stg_customers c
LEFT JOIN stg.stg_orders o ON o.customer_id = c.customer_id
WHERE c.customer_unique_id IS NOT NULL
GROUP BY c.customer_unique_id;</property>
