                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT p.product_id,
       p.product_category_name AS category_name_pt,
       COALESCE(t.product_category_name_english,
         CASE p.product_category_name
              WHEN 'pc_gamer' THEN N'pc_gamer'
              WHEN 'portateis_cozinha_e_preparadores_de_alimentos' THEN N'portable_kitchen_food_preparers'
         END,
         p.product_category_name, N'Unknown') AS category_name_en,
       p.product_name_lenght AS product_name_length,
       p.product_description_lenght AS product_description_length,
       p.product_photos_qty,
       p.product_weight_g AS weight_g,
       p.product_length_cm AS length_cm,
       p.product_height_cm AS height_cm,
       p.product_width_cm AS width_cm,
       p.product_length_cm * p.product_height_cm * p.product_width_cm AS volume_cm3
FROM stg.stg_products p
LEFT JOIN stg.stg_product_category_translation t
       ON t.product_category_name = p.product_category_name
WHERE p.product_id IS NOT NULL;</property>
