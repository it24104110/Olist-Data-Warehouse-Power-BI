            <component
              refId="Package\Load Dim_Date\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH d AS (
    SELECT CAST(DATEADD(DAY, value, '2016-01-01') AS DATE) AS dt
    FROM GENERATE_SERIES(0, 1095)
),
h AS (
    SELECT holiday_date, MIN(english_name) AS holiday_name
    FROM stg.stg_public_holidays
    WHERE is_global = 1
    GROUP BY holiday_date
)
SELECT CAST(YEAR(dt) * 10000 + MONTH(dt) * 100 + DAY(dt) AS INT) AS date_key,
       dt AS full_date,
       CAST(DAY(dt) AS TINYINT) AS day_of_month,
       CAST(DATENAME(WEEKDAY, dt) AS VARCHAR(10)) AS day_name,
       CAST(((DATEDIFF(DAY, '2016-01-04', dt) % 7) + 7) % 7 + 1 AS TINYINT) AS day_of_week,
       CAST(DATEPART(ISO_WEEK, dt) AS TINYINT) AS week_of_year,
       CAST(MONTH(dt) AS TINYINT) AS month_number,
       CAST(DATENAME(MONTH, dt) AS VARCHAR(10)) AS month_name,
       CAST(DATEPART(QUARTER, dt) AS TINYINT) AS quarter_number,
       CAST('Q' + CAST(DATEPART(QUARTER, dt) AS VARCHAR(1)) AS VARCHAR(10)) AS quarter_name,
       CAST(YEAR(dt) AS SMALLINT) AS calendar_year,
       CAST(CONVERT(CHAR(7), dt, 120) AS VARCHAR(10)) AS year_month,
       CAST(CASE WHEN ((DATEDIFF(DAY, '2016-01-04', dt) % 7) + 7) % 7 + 1 IN (6, 7) THEN 1 ELSE 0 END AS BIT) AS is_weekend,
       CAST(CASE WHEN h.holiday_date IS NOT NULL THEN 1 ELSE 0 END AS BIT) AS is_holiday,
       CAST(h.holiday_name AS NVARCHAR(100)) AS holiday_name
FROM d
LEFT JOIN h ON h.holiday_date = d.dt;</property>
