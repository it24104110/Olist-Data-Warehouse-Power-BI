      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{5BB00393-8F21-4619-97BD-F0CFF7741472}"
          SQLTask:SqlStatementSource="DELETE FROM dw.Fact_OrderFulfilment;&#xA;DELETE FROM dw.Fact_Sales;&#xA;DELETE FROM dw.Dim_PaymentType WHERE payment_type_key &lt;&gt; -1;&#xA;DELETE FROM dw.Dim_OrderStatus WHERE order_status_key &lt;&gt; -1;&#xA;DELETE FROM dw.Dim_Location    WHERE location_key &lt;&gt; -1;&#xA;DELETE FROM dw.Dim_Seller      WHERE seller_key &lt;&gt; -1;&#xA;DELETE FROM dw.Dim_Product     WHERE product_key &lt;&gt; -1;&#xA;DELETE FROM dw.Dim_Customer    WHERE customer_key &lt;&gt; -1;&#xA;DELETE FROM dw.Dim_Date        WHERE date_key &lt;&gt; -1;&#xA;&#xA;   DBCC CHECKIDENT ('dw.Dim_Seller', RESEED, 0);&#xA;   DBCC CHECKIDENT ('dw.Dim_Customer', RESEED, 0);&#xA;   DBCC CHECKIDENT ('dw.Dim_Product', RESEED, 0);&#xA;   DBCC CHECKIDENT ('dw.Dim_Location', RESEED, 0);&#xA;   DBCC CHECKIDENT ('dw.Dim_OrderStatus', RESEED, 0);&#xA;   DBCC CHECKIDENT ('dw.Dim_PaymentType', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
