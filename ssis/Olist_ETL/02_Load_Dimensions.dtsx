              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH places AS (
    SELECT customer_zip_code_prefix AS zip, LTRIM(RTRIM(customer_city)) AS city, UPPER(customer_state) AS state
    FROM stg.stg_customers
    UNION ALL
    SELECT seller_zip_code_prefix, LTRIM(RTRIM(seller_city)), UPPER(seller_state)
    FROM stg.stg_sellers
),
ranked AS (
    SELECT zip, city, state,
           ROW_NUMBER() OVER (PARTITION BY zip ORDER BY COUNT(*) DESC, city, state) AS rn
    FROM places
    WHERE zip IS NOT NULL
    GROUP BY zip, city, state
),
coords AS (
    SELECT geolocation_zip_code_prefix AS zip,
           AVG(CAST(geolocation_lat AS FLOAT)) AS lat,
           AVG(CAST(geolocation_lng AS FLOAT)) AS lng
    FROM stg.stg_geolocation
    WHERE TRY_CAST(geolocation_lat AS FLOAT) BETWEEN -34 AND 6
      AND TRY_CAST(geolocation_lng AS FLOAT) BETWEEN -75 AND -33
    GROUP BY geolocation_zip_code_prefix
)
SELECT r.zip AS zip_code_prefix,
       r.city,
       r.state AS state_code,
       s.state_name,
       COALESCE(s.region, N'Unknown') AS region,
       CAST(c.lat AS DECIMAL(9,6)) AS latitude,
       CAST(c.lng AS DECIMAL(9,6)) AS longitude
FROM ranked r
LEFT JOIN coords c ON c.zip = r.zip
LEFT JOIN (VALUES
    ('AC', N'Acre', N'North'), ('AL', N'Alagoas', N'Northeast'), ('AP', N'Amapá', N'North'),
    ('AM', N'Amazonas', N'North'), ('BA', N'Bahia', N'Northeast'), ('CE', N'Ceará', N'Northeast'),
    ('DF', N'Distrito Federal', N'Central-West'), ('ES', N'Espírito Santo', N'Southeast'),
    ('GO', N'Goiás', N'Central-West'), ('MA', N'Maranhão', N'Northeast'),
    ('MT', N'Mato Grosso', N'Central-West'), ('MS', N'Mato Grosso do Sul', N'Central-West'),
    ('MG', N'Minas Gerais', N'Southeast'), ('PA', N'Pará', N'North'), ('PB', N'Paraíba', N'Northeast'),
    ('PR', N'Paraná', N'South'), ('PE', N'Pernambuco', N'Northeast'), ('PI', N'Piauí', N'Northeast'),
    ('RJ', N'Rio de Janeiro', N'Southeast'), ('RN', N'Rio Grande do Norte', N'Northeast'),
    ('RS', N'Rio Grande do Sul', N'South'), ('RO', N'Rondônia', N'North'), ('RR', N'Roraima', N'North'),
    ('SC', N'Santa Catarina', N'South'), ('SP', N'São Paulo', N'Southeast'),
    ('SE', N'Sergipe', N'Northeast'), ('TO', N'Tocantins', N'North')
) AS s(state_code, state_name, region) ON s.state_code = r.state
WHERE r.rn = 1;</property>
