    <DTS:Executable
      DTS:refId="Package\Parse holidays"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A12845BC-B4A5-45B7-AD97-85154D65BD51}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Parse holidays"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{5BB00393-8F21-4619-97BD-F0CFF7741472}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE stg.stg_public_holidays;&#xA;&#xA;INSERT INTO stg.stg_public_holidays&#xA;       (holiday_date, local_name, english_name, country_code, is_fixed, is_global, launch_year, holiday_types, counties)&#xA;SELECT j.[date], j.localName, j.[name], j.countryCode, j.[fixed], j.[global], j.launchYear, j.types, j.counties&#xA;FROM stg.stg_holidays_raw r&#xA;CROSS APPLY OPENJSON(r.raw_json)&#xA;WITH (&#xA;    [date]      DATE          '$.date',&#xA;    localName   NVARCHAR(200) '$.localName',&#xA;    [name]      NVARCHAR(200) '$.name',&#xA;    countryCode CHAR(2)       '$.countryCode',&#xA;    [fixed]     BIT           '$.fixed',&#xA;    [global]    BIT           '$.global',&#xA;    launchYear  INT           '$.launchYear',&#xA;    types       NVARCHAR(MAX) '$.types'    AS JSON,&#xA;    counties    NVARCHAR(MAX) '$.counties' AS JSON&#xA;) AS j;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Truncate staging"
