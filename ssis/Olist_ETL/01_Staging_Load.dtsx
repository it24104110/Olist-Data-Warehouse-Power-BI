          SQLTask:SqlStatementSource="TRUNCATE TABLE stg.stg_customers;&#xA;TRUNCATE TABLE stg.stg_sellers;&#xA;TRUNCATE TABLE stg.stg_products;&#xA;TRUNCATE TABLE stg.stg_orders;&#xA;TRUNCATE TABLE stg.stg_order_items;&#xA;TRUNCATE TABLE stg.stg_order_payments;&#xA;TRUNCATE TABLE stg.stg_order_reviews;&#xA;TRUNCATE TABLE stg.stg_geolocation;&#xA;TRUNCATE TABLE stg.stg_product_category_translation;&#xA;TRUNCATE TABLE stg.stg_public_holidays;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
