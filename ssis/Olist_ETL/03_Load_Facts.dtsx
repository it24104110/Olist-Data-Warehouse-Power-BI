              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH items AS (
    SELECT order_id, COUNT(*) AS item_count
    FROM stg.stg_order_items GROUP BY order_id
),
pay AS (
    SELECT order_id, SUM(payment_value) AS payment_total
    FROM stg.stg_order_payments GROUP BY order_id
),
main_pay AS (
    SELECT order_id, payment_type, payment_installments,
           ROW_NUMBER() OVER (PARTITION BY order_id
                              ORDER BY payment_value DESC, payment_sequential ASC) AS rn
    FROM stg.stg_order_payments
),
rev AS (
    SELECT order_id, review_score,
           ROW_NUMBER() OVER (PARTITION BY order_id
                              ORDER BY review_creation_date DESC, review_answer_timestamp DESC, review_id DESC) AS rn
    FROM stg.stg_order_reviews
)
SELECT COALESCE(dpd.date_key, -1)          AS purchase_date_key,
       COALESCE(ddd.date_key, -1)          AS delivered_date_key,
       COALESCE(ded.date_key, -1)          AS estimated_delivery_date_key,
       COALESCE(dc.customer_key, -1)       AS customer_key,
       COALESCE(dl.location_key, -1)       AS customer_location_key,
       COALESCE(dos.order_status_key, -1)  AS order_status_key,
       COALESCE(dpt.payment_type_key, -1)  AS payment_type_key,
       o.order_id,
       COALESCE(i.item_count, 0)           AS item_count,
       CAST(p.payment_total AS DECIMAL(12,2)) AS payment_total,
       mp.payment_installments,
       DATEDIFF(DAY, o.order_purchase_timestamp, o.order_delivered_customer_date)      AS delivery_days,
       DATEDIFF(DAY, o.order_estimated_delivery_date, o.order_delivered_customer_date) AS delivery_delay_days,
       CASE WHEN o.order_delivered_customer_date IS NULL THEN NULL
            WHEN DATEDIFF(DAY, o.order_estimated_delivery_date, o.order_delivered_customer_date) &gt; 0 THEN CAST(1 AS BIT)
            ELSE CAST(0 AS BIT) END        AS is_late_delivery,
       r.review_score
FROM stg.stg_orders o
LEFT JOIN stg.stg_customers c    ON c.customer_id = o.customer_id
LEFT JOIN items i                ON i.order_id = o.order_id
LEFT JOIN pay p                  ON p.order_id = o.order_id
LEFT JOIN main_pay mp            ON mp.order_id = o.order_id AND mp.rn = 1
LEFT JOIN rev r                  ON r.order_id = o.order_id AND r.rn = 1
LEFT JOIN dw.Dim_Date dpd        ON dpd.full_date = CAST(o.order_purchase_timestamp AS DATE)
LEFT JOIN dw.Dim_Date ddd        ON ddd.full_date = CAST(o.order_delivered_customer_date AS DATE)
LEFT JOIN dw.Dim_Date ded        ON ded.full_date = CAST(o.order_estimated_delivery_date AS DATE)
LEFT JOIN dw.Dim_Customer dc     ON dc.customer_unique_id = c.customer_unique_id
LEFT JOIN dw.Dim_Location dl     ON dl.zip_code_prefix = c.customer_zip_code_prefix
LEFT JOIN dw.Dim_OrderStatus dos ON dos.order_status = o.order_status
LEFT JOIN dw.Dim_PaymentType dpt ON dpt.payment_type = mp.payment_type;</property>
                <property
