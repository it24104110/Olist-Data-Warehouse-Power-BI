              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT COALESCE(dd.date_key, -1)           AS order_date_key,
       COALESCE(dc.customer_key, -1)       AS customer_key,
       COALESCE(dp.product_key, -1)        AS product_key,
       COALESCE(ds.seller_key, -1)         AS seller_key,
       COALESCE(dlc.location_key, -1)      AS customer_location_key,
       COALESCE(dls.location_key, -1)      AS seller_location_key,
       COALESCE(dos.order_status_key, -1)  AS order_status_key,
       i.order_id,
       i.order_item_id,
       CAST(1 AS INT)                      AS quantity,
       i.price,
       i.freight_value,
       i.price + i.freight_value           AS item_total_value
FROM stg.stg_order_items i
JOIN stg.stg_orders o          ON o.order_id = i.order_id
LEFT JOIN stg.stg_customers c  ON c.customer_id = o.customer_id
LEFT JOIN stg.stg_sellers s    ON s.seller_id = i.seller_id
LEFT JOIN dw.Dim_Date dd       ON dd.full_date = CAST(o.order_purchase_timestamp AS DATE)
LEFT JOIN dw.Dim_Customer dc   ON dc.customer_unique_id = c.customer_unique_id
LEFT JOIN dw.Dim_Product dp    ON dp.product_id = i.product_id
LEFT JOIN dw.Dim_Seller ds     ON ds.seller_id = i.seller_id
LEFT JOIN dw.Dim_Location dlc  ON dlc.zip_code_prefix = c.customer_zip_code_prefix
LEFT JOIN dw.Dim_Location dls  ON dls.zip_code_prefix = s.seller_zip_code_prefix
LEFT JOIN dw.Dim_OrderStatus dos ON dos.order_status = o.order_status;</property>
                <property
